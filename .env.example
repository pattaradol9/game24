# --- server ---
APP_PORT=8080
DB_PATH=data/game24.db
CORS_ORIGINS=http://localhost:5173

# --- encryption (AES-256-GCM secret key) ---
# 32-byte key encoded as base64 or hex. Generate one with:
#   openssl rand -base64 32
# Local development: set ENCRYPTION_KEY directly and you are done.
ENCRYPTION_KEY=

# Production: let the service pull the key from Google Secret Manager.
# When set, the fetched value OVERRIDES ENCRYPTION_KEY. Accepted forms:
#   projects/PROJECT/secrets/NAME            (latest version)
#   projects/PROJECT/secrets/NAME/versions/V
#   NAME                                     (project from GOOGLE_CLOUD_PROJECT)
# Credentials come from ADC (GOOGLE_APPLICATION_CREDENTIALS locally, or the
# attached service account on Cloud Run/GKE/GCE — needs
# roles/secretmanager.secretAccessor and the Secret Manager API enabled).
# Losing the key = losing all encrypted player data. Never commit it.
SECRETMANAGER_ENCRYPTION_KEY=
#GOOGLE_CLOUD_PROJECT=

# --- sign in with Google ---
# OAuth 2.0 Web client id. Authorized JavaScript origins must include
# http://localhost:5173, http://localhost:8080 and your production origin.
# Leave empty to disable Google sign-in (guest play only).
GOOGLE_OAUTH_CLIENT_ID=

# --- admin portal ---
# Comma-separated allowlist of Google accounts that may enter the back-office
# portal at /admin (API under /api/v1/admin/*). Admins sign in with Google
# like any player; their session unlocks /admin while their email is listed.
# Example: ADMIN_EMAILS=you@gmail.com,colleague@gmail.com
# Leave empty to disable the admin API entirely (every admin route 404s).
ADMIN_EMAILS=
