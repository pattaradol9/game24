# --- server ---
APP_PORT=8080
DB_PATH=data/game24.db
CORS_ORIGINS=http://localhost:5173

# --- encryption (Tink envelope AEAD) ---
# local = in-process fake KMS (development/tests only)
# kms   = Google Cloud KMS as KEK (production)
ENCRYPTION_MODE=local
# gcp-kms://projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
KMS_KEY_URI=
# path to the GCP service account JSON (needs roles/cloudkms.cryptoKeyEncrypterDecrypter)
# leave empty to use Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=

# --- sign in with Google ---
# OAuth 2.0 Web client id. Authorized JavaScript origins must include
# http://localhost:5173, http://localhost:8080 and your production origin.
# Leave empty to disable Google sign-in (guest play only).
GOOGLE_OAUTH_CLIENT_ID=
